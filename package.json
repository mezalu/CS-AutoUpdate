{
  "name": "control-suite-pro-app",
  "version": "1.0.4",
  "description": "Control Suite PRO App",
  "author": "GA Tech Solutions",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "keywords": [],
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "electron-log": "^5.2.4",
    "electron-updater": "^6.3.9",
    "ps-list": "^8.1.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.control-suite-pro-app",
    "productName": "Control Suite PRO",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json",
      "utils/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/images/logo-512x512.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mezalu",
        "repo": "CS-AutoUpdate"
      }
    ]
  },
  "productName": "Control Suite PRO"
}
